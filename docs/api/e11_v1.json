    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "contact": {
      "name": "UEC i4s",
      "url": "http://i4s.uec.ac.jp"
    }
  },
  "servers": [
    {
      "url": "http://openapi.i4s.uec.ac.jp/api/v1/e11",
      "description": "Production server via API Gateway"
    },
    {
      "url": "http://openapi.i4s.uec.ac.jp:8889/v1/e11",
      "description": "Development server"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
