  "paths": {
    "/health": {
      "get": {
        "summary": "Health check endpoint",
        "description": "Returns the health status of the API server",
        "operationId": "getHealth",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "OK"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/aircons": {
      "get": {
        "tags": [
          "aircons"
        ],
        "summary": "空調ULID一覧を取得する",
        "operationId": "getAirconDeviceList",
        "responses": {
          "200": {
            "$ref": "#/components/responses/DeviceList"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          }
        }
      }
    },
    "/aircons/{ulid}": {
      "get": {
        "tags": [
          "aircons"
        ],
        "summary": "特定の空調の状態を取得する",
        "operationId": "getAirconStatus",
        "parameters": [
          {
            "$ref": "#/components/parameters/ulid"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AirconStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          }
        }
      }
    },
    "/aircons/{ulid}/mode": {
      "put": {
        "tags": [
          "aircons"
        ],
        "summary": "空調の運転モードを設定する",
        "description": "mode=0 は運転を停止する。mode≠0 は運転モードを設定した上で運転を開始する。\nmode=0: 運転停止、1: 冷房、2: 暖房、3: 送風、5: ドライ\n",
        "operationId": "updateAirconMode",
        "parameters": [
          {
            "$ref": "#/components/parameters/ulid"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "$ref": "#/components/schemas/AirconMode"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/UpdateSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          }
        }
      }
    },
    "/aircons/{ulid}/temperature": {
      "put": {
        "tags": [
          "aircons"
        ],
        "summary": "空調の設定温度を設定する",
        "description": "17~28℃の範囲で指定",
        "operationId": "updateAirconTemperature",
        "parameters": [
          {
            "$ref": "#/components/parameters/ulid"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "setpoint_temperature"
                ],
                "properties": {
                  "setpoint_temperature": {
                    "$ref": "#/components/schemas/AirconSetpointTemperature"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/UpdateSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          }
        }
      }
    },
