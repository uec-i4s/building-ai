      "description": "Energy recovery ventilator control operations"
    },
    {
      "name": "lights",
      "description": "Lighting control operations"
    },
    {
      "name": "lighting-interlocks",
      "description": "Occupancy-linked lighting control operations"
    },
    {
      "name": "co2",
      "description": "CO2 concentration data operations"
    },
    {
      "name": "humidity",
      "description": "Relative humidity data operations"
    },
    {
      "name": "temperature",
      "description": "Temperature data operations"
    },
    {
      "name": "radiant-temperature",
      "description": "Radiant temperature data operations"
    },
    {
      "name": "occupancy",
      "description": "Occupancy detection data operations"
    },
    {
      "name": "power-consumption",
      "description": "Power consumption data operations"
    },
    {
      "name": "health",
      "description": "Health check operations"
    }
