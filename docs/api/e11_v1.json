  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key authentication",
        "x-ogen-custom-security": true
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "人間が読めるエラーの要約",
            "example": "Unauthorized"
          },
          "detail": {
            "type": "string",
            "description": "インスタンス固有の詳細説明",
            "example": "有効な認証トークンが必要です"
          }
        }
      },
      "DeviceList": {
        "type": "object",
        "required": [
          "devices"
        ],
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ulid",
                "location",
                "region",
                "building",
                "room"
              ],
              "properties": {
                "ulid": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "example": "01JBGZV7E89TBDXS6Z8HE3A2J6"
                },
                "location": {
                  "type": "string",
                  "example": "UEC"
                },
                "region": {
                  "type": "string",
                  "example": "East"
                },
                "building": {
                  "type": "string",
                  "example": "A"
                },
                "room": {
                  "type": "string",
                  "example": "A-101"
                }
              }
            }
          }
        }
      },
      "AirconMode": {
        "type": "integer",
        "enum": [
          0,
          1,
          2,
          3,
          5
        ],
        "example": 1,
        "description": "運転モード。0:停止 / 1:冷房 / 2:暖房 / 3:送風 / 5:ドライ\n\n0 は運転停止を表す。値の大小に意味は無い。\n"
      },
      "AirconFanSpeed": {
        "type": "integer",
        "enum": [
          1,
          2,
          3,
          4,
          5
        ],
        "example": 5,
        "description": "風量。1:微弱 / 2:強 / 3:弱 / 4:中 / 5:自動\n\n値の大小は風量の強さの順序を表さない。\n"
      },
      "AirconSetpointTemperature": {
        "type": "number",
        "format": "float",
        "minimum": 17,
        "maximum": 28,
        "example": 24.5,
        "description": "設定温度（℃）"
      },
      "AirconRoomTemperature": {
        "type": "number",
        "format": "float",
        "minimum": -99,
        "maximum": 99,
        "example": 27.5,
        "description": "室内温度（℃）。読み取り専用"
      },
      "AirconStatus": {
        "type": "object",
        "required": [
          "mode",
          "fan_speed",
          "setpoint_temperature",
          "room_temperature"
        ],
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/AirconMode"
          },
          "fan_speed": {
            "$ref": "#/components/schemas/AirconFanSpeed"
          },
          "setpoint_temperature": {
            "$ref": "#/components/schemas/AirconSetpointTemperature"
          },
          "room_temperature": {
            "$ref": "#/components/schemas/AirconRoomTemperature"
          }
        }
      },
      "UpdateSuccess": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "VentilatorPower": {
        "type": "integer",
        "enum": [
          1,
          2,
          3
        ],
        "example": 1,
        "description": "運転状態。1:停止 / 2:運転 / 3:24時間換気\n"
      },
      "VentilatorMode": {
        "type": "integer",
        "enum": [
          1,
          2,
          3
        ],
        "example": 3,
        "description": "換気モード。1:熱交換 / 2:普通 / 3:自動\n"
      },
      "VentilatorFanSpeed": {
        "type": "integer",
        "enum": [
          1,
          2,
          3,
          5
        ],
        "example": 5,
        "description": "風量。1:微弱 / 2:強 / 3:弱 / 5:自動\n\n値の大小に意味は無い。空調機の風量とは enum が異なるため相互に変換してはならない。\n"
      },
      "VentilatorStatus": {
        "type": "object",
        "required": [
          "power",
          "mode",
          "fan_speed"
        ],
        "properties": {
          "power": {
            "$ref": "#/components/schemas/VentilatorPower"
          },
          "mode": {
            "$ref": "#/components/schemas/VentilatorMode"
          },
          "fan_speed": {
            "$ref": "#/components/schemas/VentilatorFanSpeed"
          }
        }
      },
      "LightPower": {
        "type": "integer",
        "enum": [
          0,
          1
        ],
        "example": 1,
        "description": "点灯状態。0:消灯 / 1:点灯\n"
      },
      "LightBrightness": {
        "type": "number",
        "format": "float",
        "minimum": 0,
        "maximum": 100,
        "example": 80,
        "description": "調光率（%）"
      },
      "LightStatus": {
        "type": "object",
        "required": [
          "power",
          "brightness"
        ],
        "properties": {
          "power": {
            "$ref": "#/components/schemas/LightPower"
          },
          "brightness": {
            "$ref": "#/components/schemas/LightBrightness"
          }
        }
      },
      "LightingInterlockEnabled": {
        "type": "integer",
        "enum": [
          0,
          1
        ],
        "example": 1,
        "description": "人感センサーによる照明連動制御の状態。0:連動停止 / 1:連動動作\n"
      },
      "LightingInterlockStatus": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "$ref": "#/components/schemas/LightingInterlockEnabled"
          }
        }
      },
      "Co2": {
        "type": "number",
        "format": "float",
        "example": 447,
        "description": "二酸化炭素濃度（ppm）"
      },
      "Co2Status": {
        "type": "object",
        "required": [
          "co2"
        ],
        "properties": {
          "co2": {
            "$ref": "#/components/schemas/Co2"
          }
        }
      },
      "Humidity": {
        "type": "number",
        "format": "float",
        "example": 41.5,
        "description": "相対湿度（%RH）"
      },
      "HumidityStatus": {
        "type": "object",
        "required": [
          "humidity"
        ],
        "properties": {
          "humidity": {
            "$ref": "#/components/schemas/Humidity"
          }
        }
      },
      "Temperature": {
        "type": "number",
        "format": "float",
        "example": 25.9,
        "description": "温度（℃）。空調機の room_temperature とは上流で別の点（別のセンサー）による測定値"
      },
      "TemperatureStatus": {
        "type": "object",
        "required": [
          "temperature"
        ],
        "properties": {
          "temperature": {
            "$ref": "#/components/schemas/Temperature"
          }
        }
      },
      "RadiantTemperature": {
        "type": "number",
        "format": "float",
        "example": 23.4125,
        "description": "放射温度（℃）"
      },
      "RadiantTemperatureStatus": {
        "type": "object",
        "required": [
          "radiant_temperature"
        ],
        "properties": {
          "radiant_temperature": {
            "$ref": "#/components/schemas/RadiantTemperature"
          }
        }
      },
      "Occupancy": {
        "type": "integer",
        "enum": [
          0,
          1
        ],
        "example": 0,
        "description": "人感センサーの検知状態。0:未検知 / 1:検知\n"
      },
      "OccupancyStatus": {
        "type": "object",
        "required": [
          "occupancy"
        ],
        "properties": {
          "occupancy": {
            "$ref": "#/components/schemas/Occupancy"
          }
        }
      },
      "PowerConsumption": {
        "type": "number",
        "format": "double",
        "example": 43224,
        "description": "電力量の積算値。瞬時値ではないため、期間あたりの消費量は2時点の差分を取る"
      },
      "PowerConsumptionStatus": {
        "type": "object",
        "required": [
          "power_consumption"
        ],
        "properties": {
          "power_consumption": {
            "$ref": "#/components/schemas/PowerConsumption"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "title": "Unauthorized",
              "detail": "認証情報が不足しています"
            }
          }
        }
      },
      "DeviceList": {
        "description": "Successful response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DeviceList"
            }
          }
        }
      },
      "BadGateway": {
        "description": "Bad Gateway",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "title": "Bad Gateway",
              "detail": "外部サービスとの通信に失敗しました"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "title": "Not Found",
              "detail": "指定されたULIDのデバイスが見つかりません"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "title": "Internal Server Error",
              "detail": "サーバー内部でエラーが発生しました"
            }
          }
        }
      },
      "GatewayTimeout": {
        "description": "Gateway Timeout",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "title": "Gateway Timeout",
              "detail": "外部サービスからの応答がタイムアウトしました"
            }
          }
        }
      },
      "UpdateSuccess": {
        "description": "Successful response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UpdateSuccess"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "title": "Bad Request",
              "detail": "リクエストの形式が正しくありません"
            }
          }
        }
      }
    },
    "parameters": {
      "ulid": {
        "name": "ulid",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "example": "01JBGZV7E89TBDXS6Z8HE3A2J6"
        },
        "description": "デバイスのULID"
      }
    }
  }
}